# ----------------------------------------------------------------------
# Security & Authentication
# ----------------------------------------------------------------------
# Core secret key for cryptographic operations (min 32 chars)
SECRET_KEY="your-super-secret-key-change-in-production"

# Secret key for signing JWTs
JWT_SECRET="another-super-secret-key-for-jwt"

# Algorithm used for JWT signing (default: HS256)
# ALGORITHM="HS256"

# Expiration time for access tokens in minutes (default: 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------
# SQLAlchemy Database URL
# For SQLite (Local Dev): sqlite:///options_pricing.db
# For PostgreSQL: postgresql+psycopg2://user:pass@host:5432/options_pricing
DATABASE_URL="sqlite:///options_pricing.db"

# ----------------------------------------------------------------------
# Market Data API Configuration
# ----------------------------------------------------------------------
# API key for your external market data provider (e.g. Polygon, AlphaVantage)
# MARKET_DATA_API_KEY="your-api-key-here"

# Base URL for market data API, if applicable
# MARKET_DATA_BASE_URL="https://api.polygon.io"
